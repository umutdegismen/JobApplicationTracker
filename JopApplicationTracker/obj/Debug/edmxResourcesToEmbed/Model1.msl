<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="JobApplicationDBModelStoreContainer" CdmEntityContainer="JobApplicationDBEntities">
    <EntitySetMapping Name="Applications">
      <EntityTypeMapping TypeName="JobApplicationDBModel.Application">
        <MappingFragment StoreEntitySet="Applications">
          <ScalarProperty Name="JobId" ColumnName="JobId" />
          <ScalarProperty Name="CompanyName" ColumnName="CompanyName" />
          <ScalarProperty Name="City" ColumnName="City" />
          <ScalarProperty Name="StateId" ColumnName="StateId" />
          <ScalarProperty Name="WorkEnvironmentId" ColumnName="WorkEnvironmentId" />
          <ScalarProperty Name="RequiredAdditionalTools" ColumnName="RequiredAdditionalTools" />
          <ScalarProperty Name="ApplicationWebsiteId" ColumnName="ApplicationWebsiteId" />
          <ScalarProperty Name="SalaryPerHour" ColumnName="SalaryPerHour" />
          <ScalarProperty Name="SalaryPerYear" ColumnName="SalaryPerYear" />
          <ScalarProperty Name="ApplicationDate" ColumnName="ApplicationDate" />
          <ScalarProperty Name="Notes" ColumnName="Notes" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="ApplicationWebsites">
      <EntityTypeMapping TypeName="JobApplicationDBModel.ApplicationWebsite">
        <MappingFragment StoreEntitySet="ApplicationWebsites">
          <ScalarProperty Name="Id" ColumnName="Id" />
          <ScalarProperty Name="ApplicationWebsite1" ColumnName="ApplicationWebsite" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="States">
      <EntityTypeMapping TypeName="JobApplicationDBModel.State">
        <MappingFragment StoreEntitySet="States">
          <ScalarProperty Name="Id" ColumnName="Id" />
          <ScalarProperty Name="State1" ColumnName="State" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="sysdiagrams">
      <EntityTypeMapping TypeName="JobApplicationDBModel.sysdiagram">
        <MappingFragment StoreEntitySet="sysdiagrams">
          <ScalarProperty Name="name" ColumnName="name" />
          <ScalarProperty Name="principal_id" ColumnName="principal_id" />
          <ScalarProperty Name="diagram_id" ColumnName="diagram_id" />
          <ScalarProperty Name="version" ColumnName="version" />
          <ScalarProperty Name="definition" ColumnName="definition" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="WorkEnvironments">
      <EntityTypeMapping TypeName="JobApplicationDBModel.WorkEnvironment">
        <MappingFragment StoreEntitySet="WorkEnvironments">
          <ScalarProperty Name="Id" ColumnName="Id" />
          <ScalarProperty Name="WorkEnvironment1" ColumnName="WorkEnvironment" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>