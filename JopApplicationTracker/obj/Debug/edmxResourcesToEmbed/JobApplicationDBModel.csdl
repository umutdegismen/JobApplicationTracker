      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Applications_States">
    <End Role="States" Type="Self.State" Multiplicity="0..1" />
    <End Role="Applications" Type="Self.Application" Multiplicity="*" />
