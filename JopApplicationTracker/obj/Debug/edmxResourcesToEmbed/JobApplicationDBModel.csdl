      </Dependent>
    </ReferentialConstraint>
  </Association>
  <EntityContainer Name="JobApplicationDBEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="Applications" EntityType="Self.Application" />
    <EntitySet Name="ApplicationStatus" EntityType="Self.ApplicationStatu" />
    <EntitySet Name="ApplicationWebsites" EntityType="Self.ApplicationWebsite" />
