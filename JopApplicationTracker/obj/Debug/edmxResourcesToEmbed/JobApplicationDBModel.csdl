    <Property Name="JobStatus" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <NavigationProperty Name="Applications" Relationship="Self.FK_Applications_Status" FromRole="ApplicationStatus" ToRole="Applications" />
  </EntityType>
  <EntityType Name="ApplicationWebsite">
    <Key>
      <PropertyRef Name="Id" />
    </Key>
    <Property Name="Id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="ApplicationWebsite1" Type="String" MaxLength="20" FixedLength="false" Unicode="false" Nullable="false" />
